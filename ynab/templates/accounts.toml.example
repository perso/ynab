# accounts.toml — map account numbers to YNAB budget names.
# Each section header is the account number from the exported CSV filename.
#
# budget_id is optional per account. When omitted, --budget-id is used as
# the fallback. Set it here only if this account belongs to a different budget.
#
# account_id is required when using --dedup or --upload.
#
# date_tolerance_days controls how many days of slack is allowed when matching
# bank transactions against YNAB. Defaults to 3. Credit cards often need a
# higher value (e.g. 7) because the posted date can lag the purchase date.
#
# memo_template is an optional Python format string written to the YNAB memo
# field for each transaction. Supported placeholders: {category} and
# {sub_category} (the bank's own Finnish labels). When omitted, the memo is
# left blank. Example: "{category} / {sub_category}"

[accounts.FI0000000000000001]
budget_name         = "Checking"
account_id          = "ynab-account-uuid"

[accounts.FI0000000000000002]
budget_name         = "Visa"
account_id          = "ynab-account-uuid"
date_tolerance_days = 7
# memo_template       = "{category} / {sub_category}"

# ──────────────────────────────────────────────────────────────────────────────
# Tracking accounts — investments, mortgage, loans, etc.
# Run `ynab tracking update` to interactively set new balances and post
# adjustment transactions to YNAB. All three keys are required.
# ──────────────────────────────────────────────────────────────────────────────

# [tracking_accounts.nordnet]
# name       = "Nordnet Investments"
# budget_id  = "ynab-budget-uuid"
# account_id = "ynab-account-uuid"

# [tracking_accounts.op_funds]
# name       = "OP Funds"
# budget_id  = "ynab-budget-uuid"
# account_id = "ynab-account-uuid"

# [tracking_accounts.mortgage]
# name       = "Mortgage"
# budget_id  = "ynab-budget-uuid"
# account_id = "ynab-account-uuid"
# negative   = true   # auto-negates positive input (mortgages/loans always have a negative YNAB balance)

# ──────────────────────────────────────────────────────────────────────────────
# Payee harmonization — map raw bank payee strings to clean canonical names.
# Rules are applied in order; the first matching pattern wins.
# Patterns are Python re.fullmatch expressions (anchored at both ends), so use
# .* to match trailing characters.  The original raw payee is preserved in the
# YNAB memo field for traceability.
# ──────────────────────────────────────────────────────────────────────────────

# [payee_rules]
# "ZETTLE\\*TMI BARBER.*" = "Barber"
# "K-CITYMARKET.*"        = "K-Citymarket"
# "IF VAKUUTUS.*"         = "If Vakuutus"
# ──────────────────────────────────────────────────────────────────────────────
# Emergency buffer — `ynab buffer` estimates how long the emergency fund lasts
# if income drops. PLACEHOLDER values: replace every number with your own.
#   keep        share of a group's (or "Group: Category") monthly cost you would
#               still pay in a crisis; unlisted categories keep 1.0
#   net_income  monthly NET income in the scenario (after tax)
#   income_delay_months  months with no income at all (e.g. waiting period
#               plus the first allowance payment lag)
# ──────────────────────────────────────────────────────────────────────────────

# [buffer]
# budget_id      = "ynab-budget-uuid"
# category       = "Emergency Fund"   # YNAB category whose balance is the buffer
# history_months = 12                 # complete months to average spending over
# floor_months   = 3                  # target is never below this many crisis months
# last_resort    = ["nordnet"]        # tracking account slugs shown as a last resort
# market_drop    = 0.3                # last-resort value shown after this market fall
#
# [buffer.keep]
# "Savings"            = 0.0
# "Hobbies"            = 0.2
# "Regular: Groceries" = 0.85
#
# [buffer.scenarios.bench]
# net_income = 3000
# months     = 6
#
# [buffer.scenarios.unemployed]
# net_income          = 2000
# months              = 6
# income_delay_months = 1
